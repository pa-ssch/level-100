{
	"name": "level-100",
	"version": "0.1.0",
	"description": "Level 100 – Regelsätze für Kartenspiele erstellen, teilen und spielen. Rein clientseitige Web-App.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.11"
	},
	"packageManager": "yarn@4.5.3",
	"scripts": {
		"dev": "vite dev --open",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.106.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^6.4.5",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2"
	}
}
