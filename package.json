{
	"name": "level-100",
	"version": "0.1.0",
	"description": "Level 100 – Regelsätze für Kartenspiele erstellen, teilen und spielen. Rein clientseitige Web-App.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "yarn@4.5.3",
	"scripts": {
		"dev": "vite dev --open",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:live": "playwright test -c playwright.live.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"sass": "^1.108.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"jsqr": "^1.4.0",
		"qrcode": "^1.5.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
